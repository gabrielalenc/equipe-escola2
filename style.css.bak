/* -------------------------------------------------------------
 * ESTILOS GERAIS E DESIGN SYSTEM - SEÇÃO "NOSSA EQUIPE"
 * Cores Principais: Branco, Preto, Laranja (Destaques)
 * Fontes: Outfit (Títulos), Inter (Texto de Apoio)
 * ------------------------------------------------------------- */

/* Reset & Configurações Básicas */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* Cores */
  --color-bg: #ffffff;
  --color-bg-alt: #f8f9fa;
  --color-text-primary: #121214;
  --color-text-secondary: #4b5563;
  --color-text-muted: #9ca3af;
  --color-border: #e4e4e7;
  
  /* Laranja Principal e Variações */
  --color-orange: #ea580c;
  --color-orange-light: #ff7e3d;
  --color-orange-dark: #c2410c;
  --color-orange-glow: rgba(234, 88, 12, 0.15);
  
  /* Fontes */
  --font-title: 'Outfit', sans-serif;
  --font-body: 'Inter', sans-serif;
  
  /* Transições */
  --transition-smooth: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-fast: all 0.2s ease;
}

body {
  font-family: var(--font-body);
  background-color: var(--color-bg);
  color: var(--color-text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* -------------------------------------------------------------
 * HEADER / NAVBAR INSTITUCIONAL
 * ------------------------------------------------------------- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--color-border);
  border-top: 4px solid var(--color-orange);
  padding: 16px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-logo {
  width: 40px;
  height: 40px;
  background-color: var(--color-text-primary);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-bg);
  font-weight: 800;
  font-family: var(--font-title);
  font-size: 1.2rem;
  border: 2px solid var(--color-orange);
}

.brand-text {
  font-family: var(--font-title);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-text-primary);
}

.brand-text span {
  color: var(--color-orange);
}

.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
}

.nav-links a {
  text-decoration: none;
  color: var(--color-text-secondary);
  font-weight: 500;
  font-size: 0.95rem;
  transition: var(--transition-fast);
  position: relative;
  padding: 4px 0;
}

.nav-links a:hover {
  color: var(--color-orange);
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--color-orange);
  transition: var(--transition-fast);
}

.nav-links a.active {
  color: var(--color-orange);
  font-weight: 600;
}

.nav-links a.active::after,
.nav-links a:hover::after {
  width: 100%;
}

.nav-cta {
  background-color: var(--color-text-primary);
  color: var(--color-bg);
  padding: 10px 20px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: var(--transition-fast);
  border: 1px solid var(--color-text-primary);
}

.nav-cta:hover {
  background-color: var(--color-orange);
  border-color: var(--color-orange);
  color: var(--color-bg);
  box-shadow: 0 4px 12px var(--color-orange-glow);
}

/* -------------------------------------------------------------
 * HERO SECTION
 * ------------------------------------------------------------- */
.hero {
  background-color: var(--color-text-primary);
  color: var(--color-bg);
  padding: 80px 5%;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(234, 88, 12, 0.08) 0%, rgba(0,0,0,0) 70%);
  pointer-events: none;
}

.hero-content {
  max-width: 800px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  color: var(--color-orange);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-size: 0.9rem;
  font-weight: 700;
  margin-bottom: 16px;
  display: inline-block;
  border-bottom: 2px solid var(--color-orange);
  padding-bottom: 4px;
}

.hero-title {
  font-family: var(--font-title);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 24px;
  letter-spacing: -0.02em;
}

.hero-description {
  color: var(--color-text-muted);
  font-size: clamp(1rem, 2vw, 1.2rem);
  font-weight: 400;
  max-width: 650px;
  margin: 0 auto;
}

/* -------------------------------------------------------------
 * TEAM SECTION / LAYOUT DE CATEGORIAS
 * ------------------------------------------------------------- */
.team-container {
  padding: 60px 5% 100px 5%;
  max-width: 1400px;
  margin: 0 auto;
}

.category-section {
  margin-bottom: 80px;
  scroll-margin-top: 120px;
}

.category-section:last-child {
  margin-bottom: 0;
}

.category-header {
  margin-bottom: 40px;
  position: relative;
  display: flex;
  align-items: center;
  gap: 20px;
}

.category-title {
  font-family: var(--font-title);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.category-title span {
  color: var(--color-orange);
  margin-right: 8px;
}

.category-line {
  flex-grow: 1;
  height: 2px;
  background-color: var(--color-border);
  position: relative;
}

.category-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: -2px;
  height: 6px;
  width: 60px;
  background-color: var(--color-orange);
  border-radius: 3px;
}

/* Sub-navegação para Categorias da Equipe */
.team-nav {
  background-color: var(--color-bg-alt);
  border-bottom: 1px solid var(--color-border);
  padding: 16px 5%;
  position: sticky;
  top: 73px; /* Stick right below the main navbar */
  z-index: 90;
  display: flex;
  justify-content: center;
}

.team-nav-list {
  display: flex;
  gap: 16px;
  list-style: none;
  overflow-x: auto;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
  max-width: 100%;
  padding: 4px;
}

.team-nav-list::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.team-nav-link {
  display: inline-block;
  text-decoration: none;
  color: var(--color-text-secondary);
  font-family: var(--font-title);
  font-weight: 600;
  font-size: 0.95rem;
  padding: 10px 20px;
  border-radius: 30px;
  border: 1px solid var(--color-border);
  background-color: var(--color-bg);
  transition: var(--transition-fast);
  white-space: nowrap;
}

.team-nav-link:hover {
  color: var(--color-orange);
  border-color: var(--color-orange);
  box-shadow: 0 4px 12px rgba(234, 88, 12, 0.05);
}

.team-nav-link.active {
  color: var(--color-bg);
  background-color: var(--color-orange);
  border-color: var(--color-orange);
  box-shadow: 0 4px 14px rgba(234, 88, 12, 0.2);
}

/* Grid de Membros */
.members-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 40px 32px;
}

/* -------------------------------------------------------------
 * MEMBER CARDS (COMPONENTE PRINCIPAL REESTRUTURADO)
 * ------------------------------------------------------------- */
.member-card {
  background-color: var(--color-bg);
  border-radius: 16px;
  border: 1px solid var(--color-border);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  width: 290px;
  max-width: 100%;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1), 
              border-color 0.3s ease, 
              box-shadow 0.3s ease,
              transform 0.3s ease;
  position: relative;
}

/* Hover no Desktop (apenas quando fechado) */
@media (hover: hover) {
  .member-card:not(.expanded):hover {
    transform: translateY(-6px);
    border-color: var(--color-orange);
    box-shadow: 0 12px 30px rgba(234, 88, 12, 0.1);
  }
  
  .member-card:not(.expanded):hover .member-photo {
    transform: scale(1.04);
  }
}

/* Estado Expandido - Desktop/Tablet */
@media (min-width: 600px) {
  .member-card.expanded {
    width: 650px;
    border-color: var(--color-orange);
    box-shadow: 0 16px 40px rgba(234, 88, 12, 0.12);
  }
}

/* Linha Principal (Foto + Detalhes Expansíveis) */
.card-main-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: 320px;
  position: relative;
  overflow: hidden;
}

/* Foto do Membro */
.card-media-container {
  position: relative;
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  overflow: hidden;
  background-color: var(--color-bg-alt);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (min-width: 600px) {
  .member-card.expanded .card-media-container {
    width: 260px; /* Reduz ligeiramente para dar espaço ao painel lateral */
  }
}

.member-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

/* Botão Toggle (+ / x) */
.toggle-btn {
  position: absolute;
  bottom: 16px;
  right: 16px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: var(--color-orange);
  color: var(--color-bg);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(234, 88, 12, 0.4);
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              background-color 0.3s ease,
              box-shadow 0.3s ease;
  z-index: 10;
  outline: none;
}

.toggle-btn svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Estilos de Hover/Focus do Botão */
.toggle-btn:hover,
.toggle-btn:focus-visible {
  background-color: var(--color-orange-dark);
  box-shadow: 0 6px 18px rgba(234, 88, 12, 0.6);
}

.toggle-btn:focus-visible {
  outline: 3px solid var(--color-text-primary);
  outline-offset: 2px;
}

/* Rotação e cor do botão expandido (+ vira ×) */
.member-card.expanded .toggle-btn {
  transform: rotate(135deg);
  background-color: var(--color-text-primary);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
}

/* -------------------------------------------------------------
 * PAINÉIS DE CONTEÚDO
 * ------------------------------------------------------------- */

/* Painel Resumido (Parte inferior quando fechado) */
.card-collapsed-panel {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  border-top: 1px solid var(--color-border);
  background-color: var(--color-bg);
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.4s ease,
              padding 0.5s ease;
  max-height: 200px;
  opacity: 1;
  overflow: hidden;
}

.member-card.expanded .card-collapsed-panel {
  max-height: 0;
  opacity: 0;
  padding: 0 24px;
  border-top-color: transparent;
}

.member-name {
  font-family: var(--font-title);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 6px;
  line-height: 1.2;
}

.member-role {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-orange);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 12px;
}

.member-summary {
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* Painel Expandido (Ao lado da foto) */
.card-expanded-panel {
  width: 0;
  opacity: 0;
  overflow: hidden;
  box-sizing: border-box;
  background-color: var(--color-bg);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.4s ease,
              padding 0.5s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.member-card.expanded .card-expanded-panel {
  width: 390px;
  opacity: 1;
  padding: 24px;
  overflow-y: auto;
}

.member-name-exp {
  font-family: var(--font-title);
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: 4px;
}

.member-role-exp {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--color-orange);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 16px;
}

.expanded-inner-details {
  border-top: 1px solid var(--color-border);
  padding-top: 16px;
}

.detail-item {
  margin-bottom: 16px;
}

.detail-item:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}

.detail-value {
  font-size: 0.9rem;
  color: var(--color-text-primary);
  font-weight: 500;
}

.detail-bio {
  font-size: 0.88rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  background-color: var(--color-bg-alt);
  padding: 10px;
  border-radius: 8px;
  border-left: 3px solid var(--color-orange);
  margin-top: 4px;
}

/* -------------------------------------------------------------
 * FOOTER INSTITUCIONAL (Mantendo intacto)
 * ------------------------------------------------------------- */
.footer {
  background-color: var(--color-text-primary);
  color: var(--color-bg);
  padding: 60px 5% 30px 5%;
  border-top: 6px solid var(--color-orange);
}

.footer-grid {
  max-width: 1400px;
  margin: 0 auto 40px auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
}

.footer-info h3 {
  font-family: var(--font-title);
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 16px;
}

.footer-info h3 span {
  color: var(--color-orange);
}

.footer-info p {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  max-width: 320px;
}

.footer-links h4,
.footer-contact h4 {
  font-family: var(--font-title);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 20px;
  position: relative;
  padding-bottom: 8px;
}

.footer-links h4::after,
.footer-contact h4::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 40px;
  height: 2px;
  background-color: var(--color-orange);
}

.footer-links ul {
  list-style: none;
}

.footer-links li {
  margin-bottom: 10px;
}

.footer-links a {
  text-decoration: none;
  color: var(--color-text-muted);
  font-size: 0.9rem;
  transition: var(--transition-fast);
}

.footer-links a:hover {
  color: var(--color-orange);
  padding-left: 4px;
}

.footer-contact p {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.footer-contact strong {
  color: var(--color-bg);
}

.footer-bottom {
  max-width: 1400px;
  margin: 0 auto;
  border-top: 1px solid #2e2e33;
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  color: var(--color-text-muted);
  font-size: 0.85rem;
}

.footer-socials {
  display: flex;
  gap: 16px;
}

.social-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #2e2e33;
  color: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: var(--transition-fast);
}

.social-icon:hover {
  background-color: var(--color-orange);
  transform: translateY(-2px);
}

/* -------------------------------------------------------------
 * RESPONSIVIDADE (MEDIA QUERIES)
 * ------------------------------------------------------------- */

/* Celulares e Tablets em Modo Retrato */
@media (max-width: 991px) {
  .team-nav {
    top: 72px;
  }
}

/* Tablets Médios / Telas Pequenas */
@media (max-width: 991px) and (min-width: 600px) {
  .navbar {
    padding: 16px 24px;
  }
  
  .nav-links {
    display: none; /* Simplificado */
  }
}

/* Celulares e Telas de Dispositivos Móveis Pequenos */
@media (max-width: 599px) {
  .navbar {
    padding: 14px 16px;
  }
  
  .nav-links, .nav-cta {
    display: none;
  }
  
  .brand-text {
    font-size: 1.2rem;
  }

  .hero {
    padding: 60px 16px;
  }
  
  .team-container {
    padding: 40px 16px 60px 16px;
  }
  
  .category-section {
    margin-bottom: 60px;
  }

  .category-header {
    margin-bottom: 24px;
  }
  
  .members-grid {
    width: 100%;
    gap: 36px;
  }
  
  /* Ajuste do Card no Celular */
  .member-card {
    width: 100%;
    height: auto;
  }

  /* No celular, a linha de conteúdo principal se empilha verticalmente */
  .card-main-row {
    flex-direction: column;
    height: auto;
  }

  .card-media-container {
    width: 100%;
    aspect-ratio: 3 / 3.4;
  }

  /* Painel de Expansão Lateral se torna Painel de Expansão Vertical */
  .card-expanded-panel {
    width: 100%;
    height: 0;
    opacity: 0;
    overflow: hidden;
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.4s ease,
                padding 0.5s ease;
    border-top: 1px solid var(--color-border);
  }

  .member-card.expanded .card-expanded-panel {
    width: 100%;
    height: auto;
    max-height: 600px;
    opacity: 1;
    padding: 20px;
    overflow-y: visible;
  }

  .toggle-btn {
    width: 44px;
    height: 44px;
    bottom: 16px;
    right: 16px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .footer-bottom {
    flex-direction: column;
    text-align: center;
    align-items: center;
    gap: 16px;
  }
}
